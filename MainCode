import os
import time
from itertools import islice
from dotenv import load_dotenv  # Import the dotenv loader
from openai import OpenAI
from truthbrush.api import Api

# ─── 1. Load Credentials from .env file ────────────────────────────────────
load_dotenv()  # This loads the variables from the .env file

TRUTH_USERNAME = os.getenv("TRUTH_USERNAME")
TRUTH_PASSWORD = os.getenv("TRUTH_PASSWORD")
OPENAI_KEY = os.getenv("OPENAI_API_KEY")

# Safety Check: Ensure keys exist before running
if not all([TRUTH_USERNAME, TRUTH_PASSWORD, OPENAI_KEY]):
    print("❌ Error: Missing credentials.")
    print("Please create a '.env' file with TRUTH_USERNAME, TRUTH_PASSWORD, and OPENAI_API_KEY.")
    exit(1)

# ─── 2. Initialize the API clients ─────────────────────────────────────────
print("Logging into Truth Social...")
try:
    # Initialize Truth Social API
    api = Api(username=TRUTH_USERNAME, password=TRUTH_PASSWORD)
    
    # Initialize OpenAI
    client_OpenAI = OpenAI(api_key=OPENAI_KEY)
    print("✅ Successfully logged in.")
except Exception as e:
    print(f"❌ Connection failed: {e}")
    exit(1)

# ─── 3. Helper Functions ───────────────────────────────────────────────────

def fetch_latest():
    """Fetch exactly the newest post (most recent) and return its dict."""
    try:
        # We look at Trump's profile
        post_gen = api.pull_statuses(username="realDonaldTrump", replies=False, verbose=False)
        latest = next(islice(post_gen, 1), None)
        return latest
    except Exception as e:
        print(f"Error fetching latest post: {e}")
        return None

def generate_post_link(post_id):
    return f"https://truthsocial.com/@realDonaldTrump/posts/{post_id}"

def analyze_post(input_text):
    """Send Trump post to OpenAI for market analysis."""
    user_prompt = f"""
You are a senior equity research analyst. Analyze this Truth Social post by Donald Trump.
Task:
1. Determine if it contains credible, market-relevant info.
2. If yes, explain why technically.
3. List 3 affected tickers (e.g., $TSLA).

⚠️ IMPORTANT:
- If NO credible market impact, output exactly: **Pineapple**
- Do NOT speculate on vague comments.

Input:
{input_text}
"""
    
    system_prompt = "You are a factual equity research assistant. If no market impact, return 'Pineapple'."

    try:
        response = client_OpenAI.chat.completions.create(
            model="gpt-4o-mini",
            messages=[
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt}
            ],
            temperature=0.2,
            max_tokens=1000
        )
        return response.choices[0].message.content
    except Exception as e:
        print(f"OpenAI Error: {e}")
        return "Pineapple"

# ─── 4. Main Execution Loop ────────────────────────────────────────────────
if __name__ == "__main__":
    print("Starting Truth Social tracker. Checking every 2 minutes...\n")
    
    last_seen_id = None
    
    while True:
        try:
            latest = fetch_latest()
            
            if latest is None:
                print("No posts found or connection error.")
            else:
                current_id = latest["id"]
                
                # FIRST RUN: Set the baseline ID so we don't repost old news
                if last_seen_id is None:
                    last_seen_id = current_id
                    print(f"Tracker initialized. Last post ID: {last_seen_id}")
                
                # NEW POST DETECTED
                elif current_id != last_seen_id:
                    print(f"[{latest['created_at']}] New post detected:")
                    print(latest["content"], end="\n\n")
                    
                    last_seen_id = current_id

                    # Analyze
                    analysis = analyze_post(latest["content"])
                    print(f"Market Analysis:\n{analysis}\n{'-'*80}\n")
                    
                    # Post if Market Relevant
                    if "Pineapple" not in analysis:
                        post_link = generate_post_link(latest["id"])
                        truth_post_text = f"{post_link}\n\n{analysis}"
                        
                        # Truncate to 500 chars (Truth Social Limit)
                        if len(truth_post_text) > 500:
                            truth_post_text = truth_post_text[:497] + "..."

                        try:
                            response = api.create_status(status=truth_post_text)
                            print(f"✅ Analysis posted to Truth Social! ID: {response['id']}")
                        except Exception as e:
                            print(f"❌ Failed to post to Truth Social: {e}")
                    else:
                       print("🍍 No significant market impact detected; posting skipped.") 
                
                else:
                    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] No new post.")
                    
        except Exception as e:
            print(f"Critical Loop Error: {e}") 

        time.sleep(120) # 2 minutes